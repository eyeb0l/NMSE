<Project>
  <PropertyGroup>
    <!-- Redirect build output into Build\ subdirectories to keep each project root clean.
         These properties MUST be set here (before Microsoft.Common.props is imported)
         rather than in individual .csproj files, otherwise MSBuild will use the default
         obj\ path first and then switch, causing duplicate assembly-info errors. -->
    <BaseOutputPath>Build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>Build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <!-- Ignore artifacts produced by the former shared Build paths. Generated
         sources under the active intermediate path are added explicitly by the SDK. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/Build/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
