<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NMSE</RootNamespace>
    <AssemblyName>NMSE</AssemblyName>
    <AssemblyTitle>NO MAN'S SAVE EDITOR</AssemblyTitle>
    <Description>NO MAN'S SAVE EDITOR (Open Source Save Editor for No Man's Sky)</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64'">Resources\app\NMSE.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AvaloniaProgram.cs" />
    <Compile Include="App.axaml.cs" />
    <Compile Include="Config\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Data\**\*.cs" />
    <Compile Include="IO\**\*.cs" />
    <Compile Include="Models\**\*.cs" />
    <Compile Include="UI.Avalonia\**\*.cs" />

    <AvaloniaResource Include="Resources\app\NMSGeoSans_Kerned.ttf" />
    <AvaloniaResource Include="Resources\app\NMS_Glyphs_Mono.ttf" />

    <Content Include="version.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\map\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\json\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\icons\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\images\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\ui\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep assembly metadata aligned with the package version on local builds too. -->
  <Target Name="ReadNmseVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <PropertyGroup>
      <_VersionJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/version.json'))</_VersionJson>
      <_Major>$([System.Text.RegularExpressions.Regex]::Match('$(_VersionJson)', '&quot;major&quot;\s*:\s*(\d+)').Groups[1].Value)</_Major>
      <_Minor>$([System.Text.RegularExpressions.Regex]::Match('$(_VersionJson)', '&quot;minor&quot;\s*:\s*(\d+)').Groups[1].Value)</_Minor>
      <_Patch>$([System.Text.RegularExpressions.Regex]::Match('$(_VersionJson)', '&quot;patch&quot;\s*:\s*(\d+)').Groups[1].Value)</_Patch>
      <Version>$(_Major).$(_Minor).$(_Patch)</Version>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
      <Product>NMSE</Product>
      <Company>NMSE</Company>
    </PropertyGroup>
  </Target>
</Project>
