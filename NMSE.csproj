<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NMSE</RootNamespace>
    <AssemblyName>NMSE</AssemblyName>
    <AssemblyTitle>NO MAN'S SAVE EDITOR</AssemblyTitle>
    <Description>NO MAN'S SAVE EDITOR (Open Source Save Editor for No Man's Sky)</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;linux-x64</RuntimeIdentifiers>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Resources\app\NMSE.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AvaloniaProgram.cs" />
    <Compile Include="App.axaml.cs" />
    <Compile Include="Config\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Data\**\*.cs" />
    <Compile Include="IO\**\*.cs" />
    <Compile Include="Models\**\*.cs" />
    <Compile Include="UI.Avalonia\**\*.cs" />

    <AvaloniaResource Include="Resources\app\NMSGeoSans_Kerned.ttf" />
    <AvaloniaResource Include="Resources\app\NMS_Glyphs_Mono.ttf" />

    <Content Include="version.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\map\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\json\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\icons\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\images\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\ui\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
