<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NMSE.UI.Avalonia.Dialogs.MessageDialogWindow"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto" RowSpacing="18">
    <TextBlock x:Name="MessageText" MaxWidth="620" TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button x:Name="CancelButton" MinWidth="88" Content="Cancel" Click="OnCancel" />
      <Button x:Name="AcceptButton" MinWidth="88" Content="OK" Click="OnAccept" />
    </StackPanel>
  </Grid>
</Window>
