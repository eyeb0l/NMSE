<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="8">
        <TextBlock Classes="section-title" Text="NMSE" />
        <Button Content="Preview" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Keep secondary tab rows compact, then give the application areas a
       slightly stronger hierarchy without letting their headers dominate. -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="TabItem.primary-tab">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="11,7" />
  </Style>

  <Style Selector="Border.toolbar">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
  </Style>

  <Style Selector="Border.statusbar">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
  </Style>
</Styles>
