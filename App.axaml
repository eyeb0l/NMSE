<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NMSE.App"
             Name="NMSE"
             RequestedThemeVariant="Default">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About NMSE…" Click="OnAbout" />
      <NativeMenuItem Header="Settings…" Gesture="Meta+OemComma" Click="OnPreferences" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://NMSE/UI.Avalonia/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
